<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- No -windows suffix and no WPF. This is a separate application that
         shares JinxyClicker's design and its portable logic, not a port of a
         codebase that cannot leave Windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JinxyMac</AssemblyName>
    <RootNamespace>JinxyMac</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      The compiler records where it built, and that record ships. A release DLL
      carried the full build path in its CodeView entry — the folder name and
      the account name it was built under — readable in any hex editor by
      anyone who downloaded the tarball.

      PathMap rewrites those paths to a relative "." so nothing about this
      machine travels with the binary. Deterministic builds make the rewrite
      total: without it some paths are still recorded absolutely.
    -->
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Release ships no debug record at all. PathMap cleans the source paths, but
    the reference to the .pdb itself is still an absolute path to a file the
    user does not have — leaking the same two names to no benefit, since the
    symbols are not shipped either. Debug builds keep theirs so local
    debugging still works.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Tests sit next to the code they cover. They are compiled by
      Testing/JinxyMac.Tests.csproj, which links them in by source, so the app
      must not pick them up — it has no test framework referenced.
    -->
    <Compile Remove="**/*.Tests.cs" />
    <!-- A nested project's obj/ would otherwise be globbed into this one. -->
    <Compile Remove="Testing/**" />
    <None Remove="Testing/**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The wallpaper a fresh install starts with. LogicalName pins the manifest
      name so moving this file cannot silently break Wallpaper.InstallDefault,
      which looks it up by string.
    -->
    <EmbeddedResource Include="Assets/DefaultWallpaper.png" LogicalName="DefaultWallpaper.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shipped as loose files rather than AvaloniaResource. KitImages.Find,
      Set and Remove (Core/KitImages.cs, ported unchanged from the Windows
      app) work by File.Exists, File.Copy and File.Delete against a real path
      on disk. An AvaloniaResource is an embedded manifest resource with no
      file behind it at all — reachable only through avares:// and
      AssetLoader — so those calls would find nothing. Content keeps the
      lookup working with no change to Core.

      Link rewrites the copied path from Assets\Kits\Foo.png to kits\Foo.png
      in the output, matching where KitImages.ShippedFolder() already looks
      (AppContext.BaseDirectory/kits — the folder name Setup used on
      Windows, kept as-is here rather than renamed to match the source
      folder). Packaging/build-mac.sh publishes straight into the .app's
      Contents/MacOS/<arch> folder, so this is also where the executable
      itself ends up, and AppContext.BaseDirectory at runtime is that same
      folder.
    -->
    <None Update="Assets\Kits\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>kits\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <!-- Linux-only transitive dependency, never loaded on Windows or macOS,
         pinned past a published advisory so the graph is clean. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

</Project>
