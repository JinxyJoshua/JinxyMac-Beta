<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      The app is a windowed executable and cannot be referenced as a library,
      so the classes under test are linked in by source. Only files listed
      below compile here.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Core/ClickTiming.cs" />
    <Compile Include="../Core/ClickTiming.Tests.cs" />
    <Compile Include="../Core/ClickOutput.cs" />
    <Compile Include="../Core/ClickOutput.Tests.cs" />
    <Compile Include="../Core/Presets.cs" />
    <Compile Include="../Core/Presets.Tests.cs" />
    <Compile Include="../Core/ClickHistory.cs" />
    <Compile Include="../Core/ClickHistory.Tests.cs" />
    <Compile Include="../Core/Updater.cs" />
    <Compile Include="../Core/Updater.Tests.cs" />
    <Compile Include="../Core/UpdateOffer.cs" />
    <Compile Include="../Core/UpdateOffer.Tests.cs" />
    <Compile Include="../Core/RobloxCache.cs" />
    <Compile Include="../Core/RobloxCache.Tests.cs" />
    <Compile Include="../Core/Notify.cs" />
    <Compile Include="../Core/Palette.cs" />
    <Compile Include="../Core/Palette.Tests.cs" />
    <Compile Include="../Core/SystemLoad.cs" />
    <Compile Include="../Core/SystemLoad.Tests.cs" />
    <Compile Include="../Core/CorePurity.Tests.cs" />
    <Compile Include="../Capture/CaptureBackend.cs" />
    <Compile Include="../Capture/CaptureBackend.Tests.cs" />
    <Compile Include="../Core/RemoteConfig.cs" />
    <Compile Include="../Core/RemoteConfig.Tests.cs" />
    <Compile Include="../Core/ClickButton.cs" />
    <Compile Include="../Core/ClickButton.Tests.cs" />
    <Compile Include="../Core/Wallpaper.cs" />
    <Compile Include="../Core/Wallpaper.Tests.cs" />
    <Compile Include="../Core/HotkeyBinding.cs" />
    <Compile Include="../Core/AppSettings.cs" />
    <Compile Include="../Core/AppSettings.Tests.cs" />
    <Compile Include="../Core/KeyCodes.cs" />
    <Compile Include="../Core/KeyCodes.Tests.cs" />
    <Compile Include="../Core/KeyMacro.cs" />
    <Compile Include="../Core/KeyMacro.Tests.cs" />
    <Compile Include="../Core/KeyMacroDwell.Tests.cs" />
    <Compile Include="../Core/KeyMacroWait.Tests.cs" />
    <Compile Include="../Core/MacroRunner.Tests.cs" />
    <Compile Include="../Core/SwitcherMacro.cs" />
    <Compile Include="../Core/SwitcherMacro.Tests.cs" />
    <Compile Include="../Core/SettingsPath.cs" />
    <Compile Include="../Core/SettingsPath.Tests.cs" />
    <!-- Pulled in as dependencies of the above, not tested directly. -->
    <Compile Include="../Capture/Ffmpeg.cs" />
    <Compile Include="../Core/Clicker.cs" />
    <Compile Include="../Core/Clicker.Tests.cs" />
    <Compile Include="../Engine/IClickEngine.cs" />
    <Compile Include="../Engine/IKeyEngine.cs" />
    <Compile Include="../Core/KitWheel.cs" />
    <Compile Include="../Core/KitWheel.Tests.cs" />
    <Compile Include="../Core/KitImages.cs" />
    <Compile Include="../Core/KitImages.Tests.cs" />
    <Compile Include="../Core/KitArt.cs" />
    <Compile Include="../Core/KitArt.Tests.cs" />
    <Compile Include="../Core/KitArtFetch.cs" />
    <!--
      MainWindow.KitArt.cs is not part of Core: it uses Avalonia's Bitmap, an
      Avalonia type, which is why this project below also needs Avalonia
      itself. It is a standalone static class rather than a partial of
      MainWindow, so it links in here without pulling in the window's other
      dependencies.
    -->
    <Compile Include="../MainWindow.KitArt.cs" />
    <Compile Include="../MainWindow.KitArt.Tests.cs" />
    <!-- Owned by this project, not ported from Core: boots Avalonia's
         headless Skia platform once before any test runs. -->
    <Compile Include="AvaloniaHeadlessSetup.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!--
      Only needed because MainWindow.KitArt.cs decodes pictures through
      Avalonia.Media.Imaging.Bitmap. Avalonia.Headless runs the real Skia
      decoder against a fixture on disk without a window or a display.
    -->
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.0" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WebP-under-a-wrong-extension fixture that caught the original
         WPF decode bug; kept as evidence the same fixture still decodes
         correctly under Avalonia/Skia. -->
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest"
          Link="fixtures\%(Filename)%(Extension)" />
    <!-- One real shipped kit picture, referenced from Assets/Kits rather than
         duplicated, so the end-to-end decode test resolves and reads the
         actual file the app ships rather than a copy made for the test. -->
    <None Include="../Assets/Kits/Abaddon.png" CopyToOutputDirectory="PreserveNewest"
          Link="kits\Abaddon.png" />
  </ItemGroup>

</Project>
